NODE_ID=node-1
# Shared secret, also stored on the website: 32 random bytes, base64 or hex.
# Generate with: openssl rand -base64 32
NODE_SECRET=
# Port the node listens on for direct requests (compose publishes the same
# port on the host); "off" disables direct requests.
NODE_PORT=8080
# Pull mode (optional): comma-separated mirror URLs of this node's request feed
# on S3, path-style, e.g.
# https://s3.eu-west-1.amazonaws.com/netsurveil/feeds/<key>.txt,https://s3-eu-west-1.amazonaws.com/netsurveil/feeds/<key>.txt
FEED_URLS=
# A random path segment such as /k3x9q hides the API from casual scanning.
HTTP_PATH_PREFIX=
# Rejected requests per minute per client; authenticated requests are not counted.
RATE_LIMIT_PER_MIN=30
# Behind a reverse proxy: comma-separated proxy IPs/CIDRs whose X-Forwarded-For
# identifies the client, e.g. 10.0.0.0/8. Leave empty when exposed directly.
TRUSTED_PROXIES=
ALLOW_PRIVATE_TARGETS=false
LOG_LEVEL=warn
